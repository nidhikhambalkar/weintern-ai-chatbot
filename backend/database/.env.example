# ==========================================
# WeIntern AI Chatbot - Environment Configuration (MongoDB)
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection URI
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/weintern_chatbot

# MongoDB Atlas (Cloud) Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/weintern_chatbot?retryWrites=true&w=majority

# Ollama settings (optional). Ollama should be running locally (default HTTP port 11434).
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_MS=60000
