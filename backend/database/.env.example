# Example environment variables for the backend database
# Copy this to .env and update values before starting the server

# Option A: Use a full DATABASE_URL (preferred for production / Docker)
# Example: postgres://user:password@localhost:5432/weintern_chatbot
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/weintern_chatbot

# Option B: Use individual DB_* variables (used by db.js when DATABASE_URL is unset)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weintern_chatbot

# Server port (optional)
PORT=5000

# Notes:
# 1) After creating .env, run `npm install` in this folder and then `npm start`.
# 2) To run a local PostgreSQL quickly using Docker:
#    docker run --name weintern-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=weintern_chatbot -p 5432:5432 -d postgres:15
# ==========================================
# WeIntern AI Chatbot - Environment Configuration
# ==========================================

# Server Port
PORT=5000

# PostgreSQL Connection Credentials
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weintern_chatbot

# Alternatively, a full connection URI can be provided:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weintern_chatbot

# Ollama settings (optional). Ollama should be running locally (default HTTP port 11434).
# OLLAMA_HOST can be a full URL like http://localhost:11434
# OLLAMA_MODEL is the model name to use (e.g., llama3.2)
# OLLAMA_TIMEOUT_MS sets request timeout in milliseconds (default 60000)
# Example:
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_MS=60000
