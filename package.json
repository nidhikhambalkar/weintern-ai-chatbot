    "seed:mongo": "npm run seed:mongo --prefix backend"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4"
  }
}
